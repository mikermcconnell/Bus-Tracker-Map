# Barrie GTFS static (zip)
GTFS_STATIC_URL=https://www.myridebarrie.ca/gtfs/google_transit.zip

# (Optional) GTFS-Realtime vehicle positions protobuf feed
GTFS_RT_VEHICLES_URL=https://www.myridebarrie.ca/gtfs/GTFS_VehiclePositions.pb

# (Optional) GTFS-Realtime trip updates protobuf feed
GTFS_RT_TRIP_UPDATES_URL=https://www.myridebarrie.ca/gtfs/GTFS_TripUpdates.pb

# (Optional) treat the vehicle feed as stale when its GTFS-RT timestamp is older than this many minutes
FEED_DELAYED_AFTER_MIN=2
FEED_STALE_AFTER_MIN=15
ISSUE_RESEND_MIN=30

# GTFS integrity alerts use a separate subject and a longer resend interval.
GTFS_INTEGRITY_RESEND_MIN=720

# Warn when operational alert-email volume is unusually high.
# Daily check-ins, test messages, and the volume warning itself are excluded.
EMAIL_VOLUME_WINDOW_MIN=60
EMAIL_VOLUME_ALERT_THRESHOLD=4
EMAIL_VOLUME_ALERT_COOLDOWN_MIN=180

# (Optional) GTFS-Realtime service alerts protobuf feed
GTFS_RT_ALERTS_URL=https://www.myridebarrie.ca/gtfs/GTFS_ServiceAlerts.pb

# Ontario Northland (public feeds; enabled by default)
ONTARIO_NORTHLAND_ENABLED=true
ONTARIO_NORTHLAND_GTFS_STATIC_URL=https://ontarionorthland.tmix.se/gtfs/gtfs.zip
ONTARIO_NORTHLAND_GTFS_RT_VEHICLES_URL=https://ontarionorthland.tmix.se/gtfs-realtime/vehicleupdates.pb
ONTARIO_NORTHLAND_GTFS_RT_TRIP_UPDATES_URL=https://ontarionorthland.tmix.se/gtfs-realtime/tripupdates.pb
ONTARIO_NORTHLAND_GTFS_RT_ALERTS_URL=https://ontarionorthland.tmix.se/gtfs-realtime/alerts.pb

# GO Transit at Allandale only. Keep the API key server-side.
GO_TRANSIT_ENABLED=true
METROLINX_API_KEY=
# Optional local fallback when the Metrolinx key is stored only in production.
GO_TRANSIT_PROXY_URL=
METROLINX_API_BASE=https://api.openmetrolinx.com/OpenDataAPI/api/V1
GO_TRANSIT_GTFS_STATIC_URL=https://assets.metrolinx.com/raw/upload/Documents/Metrolinx/Open%20Data/GO-GTFS.zip

# Simcoe LINX route 2 at Allandale (public feeds; enabled by default)
LINX_ENABLED=true
LINX_GTFS_STATIC_URL=https://metrolinx.tmix.se/gtfs/gtfs-simcoe.zip
LINX_GTFS_RT_TRIP_UPDATES_URL=https://metrolinx.tmix.se/gtfs-realtime-simcoe/tripupdates.pb

# (Optional) override the MyRide active-news endpoint used by the TV notice display
MYRIDE_NEWS_URL=https://myridebarrie.ca/News/GetAllNews

# Mapbox TV basemap (all three are required; defaults to OSM when omitted)
# Use a public token with styles:tiles scope and URL restrictions.
MAPBOX_ACCESS_TOKEN=
MAPBOX_USERNAME=
MAPBOX_STYLE_ID=
# Optional platform-map override. Uses MAPBOX_STYLE_ID when omitted.
PLATFORM_MAPBOX_STYLE_ID=

# Server
PORT=3000
POLL_MS=10000
