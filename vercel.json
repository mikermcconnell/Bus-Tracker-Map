{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "{cache/**,monitor/service-overrides.json,node_modules/pdfjs-dist/**,node_modules/@napi-rs/{canvas,canvas-linux-x64-gnu,canvas-linux-x64-musl}/**}"
    }
  },
  "headers": [
    {
      "source": "/notices",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' data:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self';"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/batt.map",
      "destination": "/batt.map.html"
    },
    {
      "source": "/platform.map",
      "destination": "/platform.map.html"
    },
    {
      "source": "/notices",
      "destination": "/notices.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "env": {
    "GTFS_RT_VEHICLES_URL": "https://www.myridebarrie.ca/gtfs/GTFS_VehiclePositions.pb",
    "POLL_MS": "10000"
  },
  "build": {
    "env": {
      "GTFS_STATIC_URL": "https://www.myridebarrie.ca/gtfs/google_transit.zip"
    }
  }
}
